# =====================================================================
# AI Layer & Streamlit Configuration Template
# Duplicate this file as '.env' and fill in your actual credentials.
# =====================================================================

# Amazon Redshift Connection
REDSHIFT_HOST=your-redshift-cluster-endpoint.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=YourPassword123!

# LLM Providers (Groq or OpenAI)
# Free Groq API Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Sample batch count for review enrichment
SAMPLE_N=5