# =====================================================================
# UrbanMeal Root Environment Template
# Duplicate this file as '.env' in your submodules or set these in your shell.
# =====================================================================

# Amazon Redshift Connection
REDSHIFT_HOST=your-redshift-cluster-endpoint.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=YourPassword123!

# AWS IAM Role & S3
REDSHIFT_ROLE_ARN=arn:aws:iam::<your-aws-account-id>:role/redshift-urbanmeal-role
S3_BUCKET=your-s3-bucket-name
S3_PREFIX=RAW

# AI / LLM Configuration
# Get a free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here
SAMPLE_N=5
