# =====================================================================
# Apache Airflow Configuration Template
# Duplicate this file as '.env' and fill in your actual credentials.
# =====================================================================

# Amazon Redshift Connection Details
REDSHIFT_HOST=your-redshift-cluster-endpoint.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=YourPassword123!

# AWS IAM Role attached to Redshift (for S3 COPY commands)
REDSHIFT_ROLE_ARN=arn:aws:iam::<your-aws-account-id>:role/redshift-urbanmeal-role

# AWS S3 Bucket and Prefix where dataset is uploaded
S3_BUCKET=your-s3-bucket-name
S3_PREFIX=RAW

# LLM Providers (Groq or OpenAI)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=sk-your-openai-api-key-here

# Number of reviews to enrich per DAG run
SAMPLE_N=5
